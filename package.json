{
  "name": "@m3rcena/weky",
  "version": "14.28.1",
  "description": "The ultimate Discord minigames engine with blazingly fast @napi-rs/canvas graphics, hybrid Slash/Message support, and zero external dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "import": "./dist/resolver.mjs",
      "require": "./dist/resolver.cjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.cjs"
    },
    "./host": {
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs",
      "require": "./dist/host.cjs"
    },
    "./source": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "DOCUMENTATION.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "host": "tsx src/host.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/verify.ts && tsx test/componentsV2.test.ts && tsx test/dashboard.test.ts && tsx test/managerAndCustomizations.test.ts && tsx test/v14_28_features.test.ts && tsx test/database.test.ts && tsx test/connector.test.ts && tsx test/submodule.test.ts",
    "test:bot": "tsx test/index.ts"
  },
  "keywords": [
    "weky",
    "m3rcena",
    "discord-games",
    "discord-minigames",
    "discord.js",
    "discord.js-v14",
    "canvas",
    "napi-rs-canvas",
    "game-engine",
    "slash-commands",
    "discord-bot"
  ],
  "author": "M3rcena <https://github.com/M3rcena>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M3rcena/m3rcena-weky.git"
  },
  "bugs": {
    "url": "https://github.com/M3rcena/m3rcena-weky/issues"
  },
  "homepage": "https://github.com/M3rcena/m3rcena-weky#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@m3rcena/bridge": "^14.28.1",
    "@napi-rs/canvas": "^1.1.0",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
