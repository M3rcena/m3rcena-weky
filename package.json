{
  "name": "@m3rcena/weky",
  "version": "14.27.0",
  "description": "The ultimate Discord minigames engine with blazingly fast @napi-rs/canvas graphics, hybrid Slash/Message support, and zero external dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "assets",
    "DOCUMENTATION.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/verify.ts && tsx test/componentsV2.test.ts && tsx test/dashboard.test.ts",
    "test:bot": "tsx test/index.ts"
  },
  "keywords": [
    "weky",
    "m3rcena",
    "discord-games",
    "discord-minigames",
    "discord.js",
    "discord.js-v14",
    "canvas",
    "napi-rs-canvas",
    "game-engine",
    "slash-commands",
    "discord-bot"
  ],
  "author": "M3rcena <https://github.com/M3rcena>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M3rcena/m3rcena-weky.git"
  },
  "bugs": {
    "url": "https://github.com/M3rcena/m3rcena-weky/issues"
  },
  "homepage": "https://github.com/M3rcena/m3rcena-weky#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "chalk": "^6.0.1",
    "discord.js": "^14.27.0",
    "html-entities": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
